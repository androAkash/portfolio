---
import { experienceList } from '../data/experience';
---

<section id="experience" class="experience-section">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div class="section-label mono">// 02. CAREER HISTORY</div>
      <h2 class="section-title">
        Professional <span class="gradient-text">Experience</span>
      </h2>
      <p class="section-subtitle">
        3+ years engineering production Android and multiplatform products.
      </p>
    </div>

    <!-- Vertical Timeline -->
    <div class="timeline-container">
      <div class="timeline-spine"></div>

      <div class="timeline-list">
        {experienceList.map((item, index) => (
          <div class="timeline-item reveal-on-scroll">
            <!-- Timeline Marker -->
            <div class="timeline-marker">
              <div class={`marker-dot ${item.current ? 'current-pulse' : ''}`}></div>
            </div>

            <!-- Expandable One-Line Role Accordion -->
            <details class="experience-card glass-card">
              <summary class="role-summary">
                <div class="summary-left">
                  <h3 class="role-title">{item.role}</h3>
                  <span class="role-at mono">@</span>
                  <span class="company-name">{item.company}</span>
                </div>

                <div class="summary-right">
                  <span class="period-badge mono">{item.period}</span>
                  <span class="expand-icon mono" aria-hidden="true">+</span>
                </div>
              </summary>

              <div class="role-expanded-content">
                <div class="role-meta-strip">
                  <span class="location-badge mono">{item.type}</span>
                </div>

                <!-- Highlights list from resume -->
                <ul class="highlights-list">
                  {item.highlights.map((point) => (
                    <li class="highlight-item">
                      <span class="chevron-bullet">▹</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>

                <!-- Skills tags used in this role -->
                <div class="role-skills">
                  {item.skills.map((skill) => (
                    <span class="chip cyan">{skill}</span>
                  ))}
                </div>
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
  }

  .timeline-container {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
  }

  .timeline-spine {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 20px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-violet) 0%, var(--accent-cyan) 60%, rgba(56, 189, 248, 0.1) 100%);
    box-shadow: var(--glow-violet);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .timeline-item {
    position: relative;
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  .timeline-marker {
    position: relative;
    z-index: 2;
    width: 42px;
    height: 52px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 3px solid var(--accent-cyan);
    box-shadow: 0 0 12px var(--accent-cyan);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .timeline-item:hover .marker-dot {
    transform: scale(1.25);
    border-color: var(--accent-violet);
    box-shadow: 0 0 18px var(--accent-cyan);
  }

  .current-pulse {
    border-color: var(--status-pill-text);
    box-shadow: 0 0 15px var(--status-pill-text);
    animation: markerPulse 2s infinite;
  }

  @keyframes markerPulse {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
    70% { transform: scale(1.15); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  /* Expandable One-Line Role Card */
  .experience-card {
    flex-grow: 1;
    border-radius: 14px;
    transition: all var(--transition-smooth);
    border: 1px solid var(--border-subtle);
  }

  .experience-card:hover {
    border-color: var(--border-bright);
    background: var(--bg-card-hover);
  }

  .role-summary {
    padding: 16px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    user-select: none;
    min-height: 52px;
  }

  .summary-left {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .role-title {
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .role-at {
    color: var(--accent-cyan);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .company-name {
    font-size: 0.95rem;
    color: var(--accent-violet-light);
    font-weight: 600;
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .period-badge {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-cyan);
    background: var(--badge-cyan-bg);
    border: 1px solid var(--chip-cyan-border);
    padding: 4px 10px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .expand-icon {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent-cyan);
    transition: transform var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--badge-bg);
    border: 1px solid var(--border-subtle);
  }

  .experience-card[open] .expand-icon {
    transform: rotate(45deg);
    color: var(--accent-violet-light);
    border-color: var(--border-bright);
  }

  .role-expanded-content {
    padding: 0 22px 22px 22px;
    border-top: 1px dashed var(--divider-color);
    margin-top: 2px;
    padding-top: 16px;
    animation: expandFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes expandFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .role-meta-strip {
    margin-bottom: 14px;
  }

  .location-badge {
    font-size: 0.72rem;
    color: var(--text-dim);
    background: var(--badge-bg);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--badge-border);
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 65ch;
  }

  .chevron-bullet {
    color: var(--accent-violet);
    font-size: 0.85rem;
    line-height: 1.65;
    flex-shrink: 0;
  }

  .role-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--divider-color);
  }

  @media (max-width: 640px) {
    .timeline-spine {
      left: 10px;
      top: 14px;
      bottom: 14px;
    }
    .timeline-list {
      gap: 18px;
    }
    .timeline-item {
      gap: 12px;
    }
    .timeline-marker {
      width: 22px;
      height: 48px;
    }
    .marker-dot {
      width: 10px;
      height: 10px;
      border-width: 2px;
    }
    .role-summary {
      padding: 12px 14px;
      gap: 8px;
      flex-wrap: wrap;
    }
    .summary-left {
      gap: 4px 6px;
      width: 100%;
    }
    .role-title {
      font-size: 0.98rem;
    }
    .company-name {
      font-size: 0.88rem;
    }
    .summary-right {
      width: 100%;
      justify-content: space-between;
    }
    .period-badge {
      font-size: 0.72rem;
      padding: 2px 8px;
    }
    .role-expanded-content {
      padding: 12px 14px 16px 14px;
    }
    .highlight-item {
      font-size: 0.86rem;
      gap: 8px;
    }
    .role-skills {
      padding-top: 12px;
      gap: 6px;
    }
  }

  @media (max-width: 380px) {
    .timeline-spine {
      left: 6px;
    }
    .timeline-item {
      gap: 8px;
    }
    .timeline-marker {
      width: 16px;
      height: 44px;
    }
    .marker-dot {
      width: 8px;
      height: 8px;
    }
    .role-title {
      font-size: 0.92rem;
    }
  }
</style>
