---
import { experienceList } from '../data/experience';
---

<section id="experience" class="experience-section">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div class="section-label mono">// 02. CAREER HISTORY</div>
      <h2 class="section-title">
        Professional <span class="gradient-text">Experience</span>
      </h2>
      <p class="section-subtitle">
        3+ years of professional Android and multiplatform mobile development spanning remote product development, fintech payments, clean architecture migration, and multimedia systems.
      </p>
    </div>

    <!-- Vertical Timeline -->
    <div class="timeline-container">
      <div class="timeline-spine"></div>

      <div class="timeline-list">
        {experienceList.map((item, index) => (
          <div class="timeline-item reveal-on-scroll">
            <!-- Timeline Marker -->
            <div class="timeline-marker">
              <div class={`marker-dot ${item.current ? 'current-pulse' : ''}`}></div>
            </div>

            <!-- Content Card -->
            <div class="timeline-content glass-card">
              <div class="timeline-header">
                <div class="role-company">
                  <h3 class="role-title">{item.role}</h3>
                  <div class="company-row">
                    <span class="company-name">{item.company}</span>
                    <span class="bullet-sep">•</span>
                    <span class="location-badge mono">{item.type}</span>
                  </div>
                </div>
                <div class="period-badge mono">
                  {item.period}
                </div>
              </div>

              <!-- Highlights list from resume -->
              <ul class="highlights-list">
                {item.highlights.map((point) => (
                  <li class="highlight-item">
                    <span class="chevron-bullet">▹</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>

              <!-- Skills tags used in this role -->
              <div class="role-skills">
                {item.skills.map((skill) => (
                  <span class="chip cyan">{skill}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
  }

  .timeline-container {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
  }

  .timeline-spine {
    position: absolute;
    top: 24px;
    bottom: 24px;
    left: 20px;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-violet) 0%, var(--accent-cyan) 60%, rgba(56, 189, 248, 0.1) 100%);
    box-shadow: var(--glow-violet);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .timeline-item {
    position: relative;
    display: flex;
    gap: 36px;
    align-items: flex-start;
  }

  .timeline-marker {
    position: relative;
    z-index: 2;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marker-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-primary);
    border: 3px solid var(--accent-cyan);
    box-shadow: 0 0 12px var(--accent-cyan);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .timeline-item:hover .marker-dot {
    transform: scale(1.3);
    border-color: var(--accent-violet);
    box-shadow: 0 0 20px var(--accent-cyan);
  }

  .current-pulse {
    border-color: var(--status-pill-text);
    box-shadow: 0 0 15px var(--status-pill-text);
    animation: markerPulse 2s infinite;
  }

  @keyframes markerPulse {
    0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
    70% { transform: scale(1.15); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .timeline-content {
    flex-grow: 1;
    padding: 30px;
    border-radius: 16px;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .role-title {
    font-size: 1.28rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--accent-violet-light);
    font-weight: 500;
  }

  .bullet-sep {
    color: var(--text-dim);
  }

  .location-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--badge-bg);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--badge-border);
  }

  .period-badge {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-cyan);
    background: var(--badge-cyan-bg);
    border: 1px solid var(--chip-cyan-border);
    padding: 4px 12px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .chevron-bullet {
    color: var(--accent-violet);
    font-size: 0.85rem;
    line-height: 1.6;
    flex-shrink: 0;
  }

  .role-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 18px;
    border-top: 1px solid var(--divider-color);
  }

  @media (max-width: 640px) {
    .timeline-spine {
      left: 10px;
      top: 14px;
      bottom: 14px;
    }
    .timeline-list {
      gap: 28px;
    }
    .timeline-item {
      gap: 12px;
    }
    .timeline-marker {
      width: 22px;
      height: 22px;
    }
    .marker-dot {
      width: 10px;
      height: 10px;
      border-width: 2px;
    }
    .timeline-content {
      padding: 18px 16px;
      border-radius: 14px;
    }
    .timeline-header {
      margin-bottom: 14px;
      gap: 10px;
    }
    .role-title {
      font-size: 1.1rem;
      word-break: break-word;
    }
    .company-row {
      font-size: 0.88rem;
      flex-wrap: wrap;
      gap: 4px 6px;
    }
    .period-badge {
      font-size: 0.72rem;
      padding: 3px 8px;
    }
    .highlight-item {
      font-size: 0.88rem;
      gap: 8px;
    }
    .role-skills {
      padding-top: 14px;
      gap: 6px;
    }
  }

  @media (max-width: 380px) {
    .timeline-spine {
      left: 6px;
    }
    .timeline-item {
      gap: 8px;
    }
    .timeline-marker {
      width: 16px;
      height: 16px;
    }
    .marker-dot {
      width: 8px;
      height: 8px;
    }
    .timeline-content {
      padding: 14px 12px;
    }
    .role-title {
      font-size: 1.02rem;
    }
  }
</style>
