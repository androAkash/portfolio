---
import { personalInfo } from '../data/personalInfo';
---

<footer id="contact" class="site-footer">
  <div class="container">
    <!-- Contact CTA Banner -->
    <div class="contact-banner glass-card reveal-on-scroll">
      <div class="banner-grid">
        <div class="banner-content">
          <div class="section-label mono">// 05. INITIATE TRANSMISSION</div>
          <h2 class="banner-title">
            Let's build something <span class="gradient-text">exceptional</span> together.
          </h2>
          <p class="banner-subtext">
            Available for Android engineering contracts, mobile architecture consulting, and product roles.
          </p>
        </div>

        <div class="banner-actions">
          <a href={`mailto:${personalInfo.email}`} class="btn btn-primary email-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Send Email</span>
          </a>

          <!-- Copy Email Action -->
          <button id="copy-email-btn" class="btn btn-secondary copy-btn" data-email={personalInfo.email} aria-label="Copy email address">
            <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-text">Copy Address</span>
          </button>
        </div>
      </div>

      <!-- Direct Contact Details Strip -->
      <div class="details-strip">
        <div class="strip-item">
          <span class="strip-label mono">EMAIL</span>
          <a href={`mailto:${personalInfo.email}`} class="strip-value">{personalInfo.email}</a>
        </div>
        <div class="strip-item">
          <span class="strip-label mono">PHONE</span>
          <a href={`tel:${personalInfo.phone.replace(/\s+/g, '')}`} class="strip-value">{personalInfo.phone}</a>
        </div>
        <div class="strip-item">
          <span class="strip-label mono">LOCATION</span>
          <span class="strip-value">{personalInfo.location}</span>
        </div>
      </div>
    </div>

    <!-- Bottom Footer Strip -->
    <div class="footer-bottom">
      <div class="footer-brand">
        <span class="footer-name">{personalInfo.name}</span>
        <span class="footer-role mono">Android Developer // Kotlin & Compose</span>
      </div>

      <div class="footer-socials">
        <a href={personalInfo.socials.github} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub Profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span class="mono">GitHub</span>
        </a>
        <a href={personalInfo.socials.linkedin} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn Profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span class="mono">LinkedIn</span>
        </a>
        <a href={`mailto:${personalInfo.email}`} class="social-link" aria-label="Email Me">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span class="mono">Email</span>
        </a>
      </div>

      <div class="footer-meta">
        <span class="mono">© {new Date().getFullYear()} Akash Bhattacharya</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 50px;
    padding-bottom: 50px;
    position: relative;
    border-top: 1px solid var(--border-subtle);
  }

  .contact-banner {
    padding: 48px;
    border-radius: 20px;
    margin-bottom: 56px;
    background: var(--contact-banner-bg);
    border: 1px solid var(--border-bright);
    box-shadow: var(--glow-violet);
  }

  @media (max-width: 768px) {
    .contact-banner {
      padding: 28px 20px;
    }
  }

  @media (max-width: 480px) {
    .contact-banner {
      padding: 20px 16px;
      margin-bottom: 36px;
      border-radius: 16px;
    }
  }

  .banner-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    align-items: center;
    margin-bottom: 36px;
  }

  @media (max-width: 900px) {
    .banner-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 28px;
    }
  }

  .banner-title {
    font-size: clamp(1.4rem, 4.5vw, 2.3rem);
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.25;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .banner-subtext {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: flex-start;
  }

  .email-btn {
    padding: 14px 28px;
    min-height: 48px;
  }

  .copy-btn {
    padding: 14px 22px;
    min-height: 48px;
  }

  @media (max-width: 600px) {
    .banner-actions {
      flex-direction: column;
      width: 100%;
      gap: 10px;
    }
    .email-btn, .copy-btn {
      width: 100%;
      justify-content: center;
    }
  }

  .details-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 20px;
    padding-top: 28px;
    border-top: 1px solid var(--divider-color);
  }

  @media (max-width: 480px) {
    .details-strip {
      gap: 16px;
      padding-top: 20px;
    }
  }

  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .strip-label {
    font-size: 0.72rem;
    color: var(--accent-cyan);
    letter-spacing: 0.08em;
  }

  .strip-value {
    font-size: 0.92rem;
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--transition-fast);
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  a.strip-value:hover {
    color: var(--accent-violet-light);
  }

  /* Bottom Footer */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 24px;
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding-top: 16px;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-main);
  }

  .footer-role {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    touch-action: manipulation;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .social-link:hover {
    color: var(--accent-cyan);
    transform: translateY(-2px);
  }

  .footer-meta {
    font-size: 0.78rem;
    color: var(--text-dim);
  }
</style>

<script>
  // Copy email to clipboard logic
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        const originalText = copyText.textContent;
        copyText.textContent = 'Copied to Clipboard!';
        copyBtn.classList.add('copied');

        setTimeout(() => {
          copyText.textContent = originalText;
          copyBtn.classList.remove('copied');
        }, 2500);
      } catch (err) {
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>
