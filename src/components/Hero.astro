---
import { personalInfo } from '../data/personalInfo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero-section" id="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Left Column: Content -->
      <div class="hero-content reveal-on-scroll">
        <!-- Live Status Pill -->
        <div class="status-pill mono">
          <span class="pulse-indicator">
            <span class="ping-circle"></span>
            <span class="core-circle"></span>
          </span>
          <span>{personalInfo.availability}</span>
        </div>

        <!-- Name & Subtitle -->
        <h1 class="hero-title">
          <span class="greeting mono">Hello, World! I am</span>
          <span class="name gradient-text">{personalInfo.name}</span>
          <span class="role-line">
            <span class="role-text">{personalInfo.role}</span>
            <span class="role-separator">|</span>
            <span class="tech-highlight">{personalInfo.specialty}</span>
          </span>
        </h1>

        <!-- Short Tagline (One line max) -->
        <p class="hero-tagline">
          {personalInfo.tagline}
        </p>

        <!-- CTA Action: One Primary CTA + Quick Links -->
        <div class="hero-actions">
          <a href={`${base}/projects`} class="btn btn-primary cta-btn">
            <span>View Projects</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <!-- Social Quick Icons -->
          <div class="social-quick-links">
            <a href={personalInfo.socials.github} target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="GitHub Profile">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </a>
            <a href={personalInfo.socials.linkedin} target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="LinkedIn Profile">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
            <a href={`mailto:${personalInfo.email}`} class="btn-icon" aria-label="Email Me">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- Quick Experience Badges -->
        <div class="metrics-row">
          <div class="metric-card glass-card">
            <span class="metric-num mono">3+</span>
            <span class="metric-label">Years Android Exp</span>
          </div>
          <div class="metric-card glass-card">
            <span class="metric-num mono">KMP</span>
            <span class="metric-label">Multiplatform Ready</span>
          </div>
          <div class="metric-card glass-card">
            <span class="metric-num mono">UDF</span>
            <span class="metric-label">Clean MVVM Architecture</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Code Console Visual -->
      <div class="hero-visual reveal-on-scroll">
        <div class="terminal-card">
          <div class="terminal-header">
            <div class="window-controls">
              <span class="control close"></span>
              <span class="control minimize"></span>
              <span class="control maximize"></span>
            </div>
            <div class="terminal-title mono">AkashDeveloper.kt</div>
            <div class="terminal-badge mono">Kotlin 2.0</div>
          </div>
          <div class="terminal-body mono">
            <pre><code><span class="code-keyword">data class</span> <span class="code-type">MobileArchitect</span><span class="code-punct">(</span>
  <span class="code-keyword">val</span> <span class="code-prop">name</span>: <span class="code-type">String</span> <span class="code-punct">=</span> <span class="code-string">"{personalInfo.name}"</span><span class="code-punct">,</span>
  <span class="code-keyword">val</span> <span class="code-prop">role</span>: <span class="code-type">String</span> <span class="code-punct">=</span> <span class="code-string">"Android Application Developer"</span><span class="code-punct">,</span>
  <span class="code-keyword">val</span> <span class="code-prop">stack</span>: <span class="code-type">List</span><span class="code-punct">&lt;</span><span class="code-type">Tech</span><span class="code-punct">&gt;</span> <span class="code-punct">=</span> <span class="code-func">listOf</span><span class="code-punct">(</span>
    <span class="code-string">"Kotlin"</span><span class="code-punct">,</span> <span class="code-string">"Jetpack Compose"</span><span class="code-punct">,</span>
    <span class="code-string">"ExoPlayer"</span><span class="code-punct">,</span> <span class="code-string">"Clean Architecture"</span><span class="code-punct">,</span>
    <span class="code-string">"GraphQL"</span><span class="code-punct">,</span> <span class="code-string">"KMP"</span>
  <span class="code-punct">),</span>
  <span class="code-keyword">val</span> <span class="code-prop">location</span>: <span class="code-type">String</span> <span class="code-punct">=</span> <span class="code-string">"Howrah, WB, India"</span>
<span class="code-punct">)</span>

<span class="code-annotation">@Composable</span>
<span class="code-keyword">fun</span> <span class="code-func">EngineerApp</span><span class="code-punct">()</span>: <span class="code-type">Result</span> &#123;
  <span class="code-keyword">return</span> <span class="code-func">launch</span><span class="code-punct">(</span><span class="code-type">Dispatchers</span>.<span class="code-prop">Main</span><span class="code-punct">)</span> &#123;
    <span class="code-func">deliverFluidUI</span><span class="code-punct">(</span><span class="code-param">targetFps</span> <span class="code-punct">=</span> <span class="code-number">60</span><span class="code-punct">)</span>
    <span class="code-func">reduceMemoryBoilerplate</span><span class="code-punct">()</span>
  &#125;
&#125;</code></pre>
          </div>
          <div class="terminal-footer">
            <div class="terminal-status mono">
              <span class="pulse-dot"></span>
              <span>COMPILATION: SUCCESSFUL // ZERO CRASHES</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: calc(var(--header-height) + 40px);
    padding-bottom: 70px;
    min-height: calc(88vh - var(--header-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .hero-section .container {
    margin-top: auto;
    margin-bottom: auto;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: calc(var(--header-height) + 24px);
      padding-bottom: 40px;
      min-height: auto;
    }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--status-pill-bg);
    border: 1px solid var(--status-pill-border);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--status-pill-text);
    margin-bottom: 24px;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.15);
  }

  .pulse-indicator {
    position: relative;
    width: 8px;
    height: 8px;
    display: inline-flex;
  }

  .ping-circle {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--status-pill-text);
    opacity: 0.75;
    animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .core-circle {
    position: relative;
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-emerald);
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .hero-title {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .greeting {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--accent-cyan);
    letter-spacing: 0.02em;
  }

  .name {
    font-size: clamp(2rem, 7vw, 4.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    word-break: break-word;
  }

  .role-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: clamp(0.95rem, 3.2vw, 1.35rem);
    font-weight: 600;
    color: var(--text-main);
    margin-top: 4px;
    word-break: break-word;
  }

  .role-separator {
    color: var(--accent-violet);
    opacity: 0.6;
  }

  .tech-highlight {
    color: var(--accent-violet-light);
    font-family: var(--font-mono);
    font-size: 0.95em;
  }

  .hero-tagline {
    font-size: 1.15rem;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 28px;
    font-weight: 500;
    max-width: 65ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 36px;
    width: 100%;
  }

  .cta-btn {
    padding: 14px 28px;
    font-size: 0.92rem;
  }

  .social-quick-links {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 6px;
  }

  @media (max-width: 480px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      margin-bottom: 28px;
    }
    .cta-btn {
      width: 100%;
      min-height: 48px;
    }
    .social-quick-links {
      justify-content: center;
      margin-left: 0;
    }
  }

  .metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    width: 100%;
    max-width: 580px;
  }

  @media (max-width: 520px) {
    .metrics-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .metric-card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 12px 16px;
      text-align: left;
    }
    .metric-num {
      font-size: 1.25rem;
    }
    .metric-label {
      font-size: 0.82rem;
    }
  }

  .metric-card {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-radius: 12px;
  }

  .metric-num {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .metric-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  /* Right Terminal Visual */
  .hero-visual {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .terminal-card {
    width: 100%;
    max-width: 480px;
    border-radius: 14px;
    background: #0d1117;
    border: 1px solid rgba(139, 92, 246, 0.3);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6), 0 0 30px -5px rgba(139, 92, 246, 0.2);
    overflow: hidden;
  }

  .terminal-header {
    background: #161b22;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(139, 92, 246, 0.2);
  }

  .window-controls {
    display: flex;
    gap: 7px;
  }

  .control {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .control.close { background: #ef4444; }
  .control.minimize { background: #eab308; }
  .control.maximize { background: #22c55e; }

  .terminal-title {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 500;
  }

  .terminal-badge {
    font-size: 0.68rem;
    color: #c084fc;
    background: rgba(168, 85, 247, 0.15);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .terminal-body {
    padding: 16px 14px;
    font-size: clamp(0.7rem, 2.7vw, 0.82rem);
    line-height: 1.55;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: #0d1117;
    color: #e2e8f0;
  }

  .terminal-body pre,
  .terminal-body code {
    margin: 0;
    color: #e2e8f0;
  }

  .code-keyword { color: #f43f5e; font-weight: 600; }
  .code-type { color: #38bdf8; }
  .code-prop { color: #f1f5f9; }
  .code-param { color: #c084fc; }
  .code-string { color: #34d399; }
  .code-func { color: #fbbf24; }
  .code-annotation { color: #a78bfa; font-style: italic; }
  .code-number { color: #f97316; }
  .code-punct { color: #94a3b8; }

  .terminal-footer {
    padding: 10px 20px;
    background: #090d14;
    border-top: 1px solid rgba(139, 92, 246, 0.2);
  }

  .terminal-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.68rem;
    color: #38bdf8;
    letter-spacing: 0.05em;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }
</style>
