---
interface Props {
  title: string;
  year: string | number;
  oneLineDescription: string;
  tags: string[];
  github?: string;
  demo?: string;
  metrics?: string;
  role?: string;
}

const { title, year, oneLineDescription, tags, github, demo, metrics, role } = Astro.props;
---

<article class="project-card glass-card reveal-on-scroll">
  <div class="card-inner">
    <!-- Title -->
    <h3 class="project-title">
      {title}
    </h3>

    <!-- One-line description (first sentence of markdown body) -->
    <p class="project-one-line">
      {oneLineDescription}
    </p>

    <!-- Tech Stack Chips (Labels only) -->
    <div class="tags-container">
      {tags.map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>

    <!-- Card Bottom: Links & Expandable Details -->
    <div class="card-bottom">
      <div class="card-actions">
        {github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="action-link" aria-label={`View ${title} GitHub repository`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <span class="mono">Source Code</span>
          </a>
        )}

        {demo && (
          <a href={demo} target="_blank" rel="noopener noreferrer" class="action-link demo-link" aria-label={`View ${title} live preview`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span class="mono">Preview / Repo</span>
          </a>
        )}
      </div>

      <!-- Expandable Details Section -->
      <details class="project-details">
        <summary class="details-toggle mono">
          <span class="toggle-text">Details</span>
          <span class="toggle-arrow">→</span>
        </summary>

        <div class="details-drawer">
          <div class="drawer-meta mono">
            <span class="meta-tag">{year}</span>
            {role && <span class="meta-tag role-tag">{role}</span>}
            {metrics && <span class="meta-tag metric-tag">{metrics}</span>}
          </div>

          <div class="drawer-prose">
            <slot />
          </div>
        </div>
      </details>
    </div>
  </div>
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
  }

  .card-inner {
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .project-title {
    font-size: clamp(1.18rem, 4vw, 1.35rem);
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.3;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .project-one-line {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 18px;
    max-width: 65ch;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .card-bottom {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--divider-color);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 40px;
    touch-action: manipulation;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .action-link:hover {
    color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  .demo-link {
    color: var(--accent-cyan);
  }

  .demo-link:hover {
    color: var(--accent-violet);
  }

  /* Expandable Details Section */
  .project-details {
    width: 100%;
  }

  .details-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-cyan);
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--chip-cyan-bg);
    border: 1px solid var(--chip-cyan-border);
    transition: all var(--transition-fast);
    user-select: none;
    min-height: 38px;
    width: fit-content;
  }

  .details-toggle:hover {
    background: var(--chip-cyan-hover-bg);
    border-color: var(--accent-cyan);
    color: var(--chip-hover-text);
  }

  .toggle-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  details[open] .toggle-arrow {
    transform: rotate(90deg);
  }

  .details-drawer {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed var(--divider-color);
    animation: drawerFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawerFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .drawer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.72rem;
  }

  .meta-tag {
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--badge-bg);
    border: 1px solid var(--badge-border);
    color: var(--text-muted);
  }

  .role-tag {
    color: var(--accent-violet-light);
    border-color: var(--chip-border);
    background: var(--chip-bg);
  }

  .metric-tag {
    color: var(--status-pill-text);
    border-color: var(--status-pill-border);
    background: var(--status-pill-bg);
  }

  .drawer-prose {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .drawer-prose :global(h3) {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    margin-top: 14px;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .drawer-prose :global(p) {
    margin-bottom: 12px;
    line-height: 1.7;
    max-width: 65ch;
  }

  .drawer-prose :global(ul) {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 14px;
  }

  .drawer-prose :global(li) {
    position: relative;
    padding-left: 18px;
    line-height: 1.65;
  }

  .drawer-prose :global(li::before) {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-violet);
    font-size: 0.85rem;
  }

  .drawer-prose :global(strong) {
    color: var(--text-main);
    font-weight: 600;
  }

  .drawer-prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.82em;
    color: var(--accent-cyan);
    background: var(--badge-cyan-bg);
    padding: 2px 5px;
    border-radius: 4px;
    border: 1px solid var(--chip-cyan-border);
  }

  @media (max-width: 480px) {
    .card-inner {
      padding: 20px 16px;
    }
    .tags-container {
      gap: 6px;
      margin-bottom: 16px;
    }
    .project-one-line {
      font-size: 0.88rem;
    }
    .card-actions {
      gap: 12px;
    }
  }
</style>
