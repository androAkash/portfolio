---
interface Props {
  title: string;
  year: string | number;
  description: string;
  tags: string[];
  github?: string;
  demo?: string;
  metrics?: string;
  role?: string;
}

const { title, year, description, tags, github, demo, metrics, role } = Astro.props;
---

<article class="project-card glass-card reveal-on-scroll">
  <div class="card-inner">
    <!-- Header: Year & Role/Metrics badge -->
    <div class="card-top">
      <div class="year-badge mono">{year}</div>
      {metrics && <div class="metric-pill mono">{metrics}</div>}
    </div>

    <!-- Title -->
    <h3 class="project-title">
      {title}
    </h3>

    {role && <div class="project-role mono">{role}</div>}

    <!-- Description -->
    <p class="project-description">
      {description}
    </p>

    <!-- Tech Stack Chips -->
    <div class="tags-container">
      {tags.map((tag) => (
        <span class="chip">{tag}</span>
      ))}
    </div>

    <!-- Links / Actions -->
    <div class="card-actions">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="action-link" aria-label={`View ${title} GitHub repository`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span class="mono">Source Code</span>
        </a>
      )}

      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="action-link demo-link" aria-label={`View ${title} live preview`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span class="mono">Preview / Repo</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
  }

  .card-inner {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .year-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-cyan);
    background: var(--badge-cyan-bg);
    border: 1px solid var(--chip-cyan-border);
    padding: 3px 10px;
    border-radius: 6px;
  }

  .metric-pill {
    font-size: 0.7rem;
    color: var(--accent-violet-light);
    background: var(--chip-bg);
    border: 1px solid var(--chip-border);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .project-title {
    font-size: clamp(1.15rem, 4vw, 1.35rem);
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.3;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .project-role {
    font-size: 0.78rem;
    color: var(--accent-violet-light);
    margin-bottom: 14px;
    font-weight: 500;
  }

  .project-description {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--divider-color);
    margin-top: auto;
    flex-wrap: wrap;
  }

  .action-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text-muted);
    text-decoration: none;
    min-height: 44px;
    touch-action: manipulation;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .action-link:hover {
    color: var(--accent-cyan);
    transform: translateY(-1px);
  }

  .demo-link {
    color: var(--accent-cyan);
  }

  .demo-link:hover {
    color: var(--accent-violet);
  }

  @media (max-width: 480px) {
    .card-inner {
      padding: 20px 16px;
    }
    .tags-container {
      gap: 6px;
      margin-bottom: 16px;
    }
    .project-description {
      font-size: 0.88rem;
    }
    .card-actions {
      gap: 12px;
    }
  }
</style>
