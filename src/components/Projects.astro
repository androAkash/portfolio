---
import { getCollection, render } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// Fetch all project markdown entries from src/content/projects/
const rawProjects = await getCollection('projects');

// Sort projects by order ascending, or by year descending
const sortedProjects = rawProjects.sort((a, b) => {
  const orderA = a.data.order ?? 99;
  const orderB = b.data.order ?? 99;
  return orderA - orderB;
});

function getFirstSentence(markdown: string): string {
  const withoutHeadings = markdown.replace(/^#+\s+.*$/gm, '').trim();
  const clean = withoutHeadings.replace(/[*_`]/g, '').trim();
  const match = clean.match(/^([^.!?\n]+[.!?])/);
  if (match) {
    return match[1].trim();
  }
  const firstLine = clean.split('\n').map(l => l.trim()).filter(Boolean)[0];
  return firstLine || '';
}

const renderedProjects = await Promise.all(
  sortedProjects.map(async (project) => {
    const { Content } = await render(project);
    const oneLine = getFirstSentence(project.body || '');
    return {
      project,
      Content,
      oneLine,
    };
  })
);
---

<section id="projects" class="projects-section">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div class="section-label mono">// 01. FEATURED PROJECTS</div>
      <h2 class="section-title">
        Engineered for <span class="gradient-text">Performance & Scale</span>
      </h2>
      <p class="section-subtitle">
        Selected Android and multiplatform applications built with Kotlin and Jetpack Compose.
      </p>
    </div>

    <!-- Project Cards Grid -->
    <div class="projects-grid">
      {renderedProjects.map(({ project, Content, oneLine }) => (
        <ProjectCard
          title={project.data.title}
          year={project.data.year}
          oneLineDescription={oneLine}
          tags={project.data.tags}
          github={project.data.github}
          demo={project.data.demo}
          metrics={project.data.metrics}
          role={project.data.role}
        >
          <Content />
        </ProjectCard>
      ))}
    </div>

    <!-- Information callout on how Content Collections work -->
    <div class="content-collection-callout glass-card reveal-on-scroll">
      <div class="callout-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
      </div>
      <div class="callout-text">
        <span class="callout-heading mono">Modular Architecture:</span>
        <span class="callout-body">Projects loaded directly from Markdown content collections in <code>src/content/projects/</code>.</span>
      </div>
    </div>

    <!-- Decorative Android Phone Mockup (UI Preview Showcase) -->
    <div class="phone-mockup-wrapper decorative-mockup reveal-on-scroll">
      <div class="phone-mockup device-mockup" aria-hidden="true">
        <div class="mockup-bezel">
          <div class="mockup-camera-notch"></div>
          <div class="mockup-screen">
            <div class="mockup-status-bar">
              <span class="mono">09:41</span>
              <div class="status-right mono">
                <span>5G</span>
                <span>100%</span>
              </div>
            </div>
            <div class="mockup-body">
              <div class="mockup-app-header">
                <span class="mockup-app-badge mono">JETPACK COMPOSE</span>
                <h4 class="mockup-app-title">One-Percent Habit Canvas</h4>
              </div>
              <div class="mockup-heatmap-grid">
                <div class="cell lvl-1"></div>
                <div class="cell lvl-3"></div>
                <div class="cell lvl-4"></div>
                <div class="cell lvl-2"></div>
                <div class="cell lvl-4"></div>
                <div class="cell lvl-3"></div>
                <div class="cell lvl-4"></div>
                <div class="cell lvl-2"></div>
                <div class="cell lvl-4"></div>
                <div class="cell lvl-1"></div>
              </div>
              <div class="mockup-stat-pill mono">
                <span>60 FPS RENDERED // ROOM DB</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  .section-header {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    transform: none;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 28px;
    margin-bottom: 40px;
    width: 100%;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }
  }

  .content-collection-callout {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 24px;
    border-radius: 12px;
    background: var(--chip-bg);
    border: 1px dashed var(--chip-border);
    width: 100%;
    max-width: 100%;
  }

  @media (max-width: 640px) {
    .content-collection-callout {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 16px 14px;
    }
  }

  .callout-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .callout-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    word-break: break-word;
  }

  .callout-heading {
    color: var(--accent-violet-light);
    font-weight: 600;
    margin-right: 6px;
  }

  .callout-body code {
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    background: var(--badge-cyan-bg);
    border: 1px solid var(--chip-cyan-border);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.8em;
    word-break: break-all;
  }

  /* Decorative Phone Mockup */
  .phone-mockup-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 52px;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .phone-mockup {
    width: 270px;
    background: var(--bg-card);
    border: 3px solid var(--border-bright);
    border-radius: 34px;
    padding: 12px;
    box-shadow: var(--glow-violet);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .mockup-bezel {
    border-radius: 24px;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mockup-camera-notch {
    width: 44px;
    height: 5px;
    background: var(--border-bright);
    border-radius: 10px;
    margin: 0 auto 4px;
  }

  .mockup-status-bar {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: var(--text-dim);
    padding: 0 4px;
  }

  .status-right {
    display: flex;
    gap: 6px;
  }

  .mockup-app-badge {
    font-size: 0.62rem;
    color: var(--accent-cyan);
    letter-spacing: 0.08em;
  }

  .mockup-app-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-main);
    margin-top: 3px;
    margin-bottom: 12px;
  }

  .mockup-heatmap-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 6px;
    margin-bottom: 14px;
  }

  .mockup-heatmap-grid .cell {
    height: 20px;
    border-radius: 4px;
    background: var(--chip-bg);
  }

  .mockup-heatmap-grid .lvl-1 { background: rgba(56, 189, 248, 0.2); }
  .mockup-heatmap-grid .lvl-2 { background: rgba(56, 189, 248, 0.45); }
  .mockup-heatmap-grid .lvl-3 { background: rgba(139, 92, 246, 0.6); }
  .mockup-heatmap-grid .lvl-4 { background: var(--accent-cyan); }

  .mockup-stat-pill {
    font-size: 0.62rem;
    color: var(--accent-emerald);
    background: var(--status-pill-bg);
    border: 1px solid var(--status-pill-border);
    padding: 4px 8px;
    border-radius: 6px;
    text-align: center;
  }

  /* CRITICAL: Hide decorative phone mockup below 768px so it never overlaps cards on mobile */
  @media (max-width: 768px) {
    .phone-mockup-wrapper,
    .phone-mockup,
    .device-mockup,
    .decorative-mockup {
      display: none !important;
    }
  }
</style>
