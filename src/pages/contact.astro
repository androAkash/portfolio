---
import Layout from '../layouts/Layout.astro';
import { personalInfo } from '../data/personalInfo';
---

<Layout
  title={`Contact — ${personalInfo.name} | Android Developer`}
  description="Get in touch with Akash Bhattacharya for Android development, Kotlin Multiplatform, and contract opportunities."
>
  <div class="page-container container">
    <div class="section-header reveal-on-scroll">
      <div class="section-label mono">// 05. INITIATE TRANSMISSION</div>
      <h1 class="section-title">
        Let's Build Something <span class="gradient-text">Exceptional</span>
      </h1>
      <p class="section-subtitle">
        Whether you are planning a high-performance Android application with Jetpack Compose, migrating to Kotlin Multiplatform, or seeking experienced mobile engineering, reach out directly.
      </p>
    </div>

    <div class="contact-page-grid">
      <!-- Contact Details & Quick Links Card -->
      <div class="contact-info-card glass-card reveal-on-scroll">
        <h2 class="card-heading mono">Direct Communication Channels</h2>
        
        <div class="channels-list">
          <div class="channel-item">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="channel-details">
              <span class="channel-label mono">EMAIL ADDRESS</span>
              <a href={`mailto:${personalInfo.email}`} class="channel-link">{personalInfo.email}</a>
            </div>
          </div>

          <div class="channel-item">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="channel-details">
              <span class="channel-label mono">TELEPHONE</span>
              <a href={`tel:${personalInfo.phone.replace(/\s+/g, '')}`} class="channel-link">{personalInfo.phone}</a>
            </div>
          </div>

          <div class="channel-item">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="channel-details">
              <span class="channel-label mono">LOCATION BASE</span>
              <span class="channel-text">{personalInfo.location}</span>
            </div>
          </div>
        </div>

        <div class="social-strip">
          <a href={personalInfo.socials.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary social-btn" aria-label="GitHub Profile">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <span class="mono">GitHub</span>
          </a>

          <a href={personalInfo.socials.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary social-btn" aria-label="LinkedIn Profile">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            <span class="mono">LinkedIn</span>
          </a>

          <a href={personalInfo.resumeUrl} download="Akash_Bhattacharya_Resume.pdf" class="btn btn-secondary social-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span class="mono">Resume</span>
          </a>
        </div>
      </div>

      <!-- Quick Message Dispatch Card -->
      <div class="message-composer-card glass-card reveal-on-scroll">
        <h2 class="card-heading mono">Instant Email Dispatch</h2>
        
        <form id="contact-form" class="composer-form">
          <div class="form-group">
            <label for="contact-name" class="mono form-label">YOUR NAME</label>
            <input type="text" id="contact-name" class="form-input" placeholder="e.g. Alex Mercer" required />
          </div>

          <div class="form-group">
            <label for="contact-subject" class="mono form-label">SUBJECT</label>
            <input type="text" id="contact-subject" class="form-input" placeholder="e.g. Android Mobile App Project" required />
          </div>

          <div class="form-group">
            <label for="contact-body" class="mono form-label">MESSAGE</label>
            <textarea id="contact-body" rows="5" class="form-input form-textarea" placeholder="Describe project goals, timeline, or inquiries..." required></textarea>
          </div>

          <div class="composer-actions">
            <button type="submit" class="btn btn-primary dispatch-btn">
              <span>Compose Transmission</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
            <span id="form-feedback" class="feedback-text mono"></span>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-page-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 36px;
    align-items: flex-start;
  }

  @media (max-width: 900px) {
    .contact-page-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .contact-info-card, .message-composer-card {
    padding: 36px 32px;
    border-radius: 18px;
  }

  @media (max-width: 600px) {
    .contact-info-card, .message-composer-card {
      padding: 24px 20px;
    }
  }

  @media (max-width: 480px) {
    .contact-info-card, .message-composer-card {
      padding: 20px 16px;
    }
  }

  .card-heading {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-bottom: 24px;
    letter-spacing: 0.06em;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--divider-color);
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 32px;
  }

  .channel-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  @media (max-width: 400px) {
    .channel-item {
      gap: 12px;
    }
  }

  .channel-icon {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 10px;
    background: var(--chip-bg);
    border: 1px solid var(--border-subtle);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .channel-label {
    font-size: 0.72rem;
    color: var(--accent-violet-light);
    letter-spacing: 0.08em;
  }

  .channel-link, .channel-text {
    font-size: 0.98rem;
    color: var(--text-main);
    text-decoration: none;
    transition: color var(--transition-fast);
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  a.channel-link:hover {
    color: var(--accent-cyan);
  }

  .social-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 24px;
    border-top: 1px solid var(--divider-color);
  }

  .social-btn {
    padding: 10px 18px;
    font-size: 0.8rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
  }

  @media (max-width: 480px) {
    .social-btn {
      flex: 1 1 calc(50% - 8px);
      padding: 10px 12px;
      font-size: 0.78rem;
    }
  }

  /* Form styling */
  .composer-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .form-input {
    width: 100%;
    padding: 12px 16px;
    min-height: 44px;
    border-radius: 8px;
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    color: var(--text-main);
    font-family: var(--font-sans);
    font-size: 16px;
    outline: none;
    transition: all var(--transition-fast);
  }

  .form-input:focus {
    background: var(--input-focus-bg);
    border-color: var(--accent-cyan);
    box-shadow: var(--glow-cyan);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
  }

  .composer-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .dispatch-btn {
    min-height: 48px;
  }

  @media (max-width: 600px) {
    .dispatch-btn {
      width: 100%;
    }
  }
    padding: 14px 26px;
  }

  .feedback-text {
    font-size: 0.8rem;
    color: var(--accent-cyan);
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('contact-name') as HTMLInputElement;
      const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
      const bodyInput = document.getElementById('contact-body') as HTMLTextAreaElement;

      const name = nameInput?.value.trim() || '';
      const subject = subjectInput?.value.trim() || 'Portfolio Inquiry';
      const body = bodyInput?.value.trim() || '';

      const fullBody = `Hello Akash,\n\n${body}\n\nBest regards,\n${name}`;
      const mailtoUrl = `mailto:akashbhattacharyak1314@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullBody)}`;

      if (feedback) {
        feedback.textContent = 'Opening email client...';
      }

      window.location.href = mailtoUrl;

      setTimeout(() => {
        if (feedback) {
          feedback.textContent = 'Transmission initiated! Check your mail client.';
        }
      }, 1000);
    });
  }
</script>
