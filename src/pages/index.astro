---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { personalInfo } from '../data/personalInfo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const hubSections = [
  {
    code: "// 01",
    title: "Featured Projects",
    description: "Production-grade Android apps featuring custom Canvas HeatMap components, low-latency ExoPlayer buffering, and realtime GraphQL dashboards.",
    href: `${base}/projects`,
    tag: "3 Projects",
    cta: "Explore Projects →",
  },
  {
    code: "// 02",
    title: "Career History",
    description: "3+ years professional track record across IIPROF Consultancy, Score Information, and Xellier Network Solutions specializing in Kotlin & Compose.",
    href: `${base}/experience`,
    tag: "4 Positions",
    cta: "View Timeline →",
  },
  {
    code: "// 03",
    title: "Skills & Tooling",
    description: "Deep dive into Kotlin, Swift, Jetpack Compose, Clean MVVM architecture, ExoPlayer, Room DB, Ktor, and Kotlin Multiplatform (KMP).",
    href: `${base}/skills`,
    tag: "25+ Skills",
    cta: "Inspect Tech Stack →",
  },
  {
    code: "// 04",
    title: "Education & Credentials",
    description: "University of Calcutta Bachelor of Commerce graduate alongside verified certifications in Jetpack Compose, Ktor APIs, and Kotlin development.",
    href: `${base}/education`,
    tag: "3 Certifications",
    cta: "View Credentials →",
  },
  {
    code: "// 05",
    title: "Contact & Transmission",
    description: "Get in touch directly for high-impact Android engineering contracts, full-time opportunities, or architectural consultations.",
    href: `${base}/contact`,
    tag: "Open for Roles",
    cta: "Initiate Contact →",
  },
];
---

<Layout>
  <Hero />

  <!-- Section Hub / Directory -->
  <section class="hub-section">
    <div class="container">
      <div class="section-header reveal-on-scroll">
        <div class="section-label mono">// PORTFOLIO DIRECTORY</div>
        <h2 class="section-title">
          Explore by <span class="gradient-text">Domain & Specialty</span>
        </h2>
        <p class="section-subtitle">
          Navigate through dedicated sections detailing projects, engineering experience, technology toolsets, and contact channels.
        </p>
      </div>

      <div class="hub-grid">
        {hubSections.map((item) => (
          <a href={item.href} class="hub-card glass-card reveal-on-scroll">
            <div class="hub-top">
              <span class="hub-code mono">{item.code}</span>
              <span class="hub-tag mono">{item.tag}</span>
            </div>

            <h3 class="hub-title">{item.title}</h3>
            <p class="hub-desc">{item.description}</p>

            <div class="hub-cta mono">
              <span>{item.cta}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hub-section {
    padding-top: 20px;
    padding-bottom: 70px;
  }

  @media (max-width: 640px) {
    .hub-section {
      padding-top: 10px;
      padding-bottom: 48px;
    }
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 24px;
  }

  @media (max-width: 640px) {
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  .hub-card {
    padding: 28px 24px;
    border-radius: 16px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  @media (max-width: 480px) {
    .hub-card {
      padding: 20px 16px;
    }
  }

  .hub-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hub-code {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .hub-tag {
    font-size: 0.72rem;
    color: var(--accent-violet-light);
    background: var(--chip-bg);
    border: 1px solid var(--chip-border);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .hub-title {
    font-size: clamp(1.15rem, 3.5vw, 1.28rem);
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .hub-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .hub-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-cyan);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--divider-color);
    min-height: 44px;
    touch-action: manipulation;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .hub-card:hover .hub-cta {
    color: var(--accent-violet-light);
    transform: translateX(4px);
  }
</style>
